---
const { selectedItem } = Astro.props;
---

<aside
  data-animation="default"
  data-collapse="medium"
  data-duration="400"
  data-easing="ease"
  data-easing2="ease"
  role="banner"
  class="sidebar w-nav"
>
  <div class="nav-content">

    <!-- Profile -->
    <a href="/codefolio/" class="w-nav-brand" aria-label="home">
      <div class="niv-data">
        <div class="profile-data">
          <div class="label-white">
            Charulatha P
          </div>

          <div class="label-gray">
            Python Developer | Fresher
          </div>
        </div>
      </div>
    </a>

    <!-- Navigation -->
    <nav role="navigation" class="w-nav-menu">

      <!-- Home -->
      <a href="/codefolio/" class="nav-link-container">
        <img
          src="/codefolio/assets/home.svg"
          loading="eager"
          alt="Home"
          class="nav-link-image"
        />
        <div>Home</div>
      </a>
      <a href="/codefolio/about/" class="nav-link-container">
        <img
          src="/codefolio/assets/browser.svg"
          loading="eager"
          alt="About"
          class="nav-link-image"
        />
        <div>About</div>
      </a>
      <!-- Education -->
      <a href="/codefolio/education/" class="nav-link-container">
        <img
          src="/codefolio/assets/database.svg"
          loading="eager"
          alt="Education"
          class="nav-link-image"
        />
        <div>Education</div>
      </a>

      <!-- Skills -->
      <a href="/codefolio/skills/" class="nav-link-container">
        <img
          src="/codefolio/assets/code.svg"
          loading="eager"
          alt="Skills"
          class="nav-link-image"
        />
       <div>Skills</div>
      </a>

      <!-- Experience -->
      <a href="/codefolio/experience/" class="nav-link-container">
        <img
          src="/codefolio/assets/dns.svg"
          loading="eager"
          alt="Experience"
          class="nav-link-image"
        />
        <div>Experience</div>
      </a>

      <!-- Projects -->
      <a href="/codefolio/projects/" class="nav-link-container">
        <img
          src="/codefolio/assets/favorite.svg"
          loading="eager"
          alt="Projects"
          class="nav-link-image"
        />
        <div>Projects</div>
      </a>

      <!-- Contact -->
      <a href="/codefolio/contact/" class="nav-link-container">
        <img
          src="/codefolio/assets/browser.svg"
          loading="eager"
          alt="Contact"
          class="nav-link-image"
        />
        <div>Contact</div>
      </a>

      <!-- Resume -->
      <a
        href="/codefolio/resume/Charulatha_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-link-container w-inline-block"
      >
        <img
          src="/codefolio/assets/back.svg"
          loading="eager"
          alt="Resume"
          class="nav-link-image"
        />
        <div>Resume</div>
      </a>

    </nav>

    <!-- Mobile Menu Button -->
    <div
      class="navbar-icon-button w-nav-button"
      style="-webkit-user-select: text;"
      aria-label="menu"
      role="button"
      tabindex="0"
    >
      <img
        src={`${import.meta.env.BASE_URL}assets/menu.svg`}
        loading="eager"
        alt="Menu"
        class="navbar-icon"
      />
    </div>

  </div>

  <script>
    import { setupNav } from "../scripts/nav.js";

    let cleanup;

    document.addEventListener("astro:page-load", () => {
      if (cleanup) cleanup();
      cleanup = setupNav();
    });

    document.addEventListener("astro:before-swap", () => {
      if (cleanup) cleanup();
    });
  </script>

</aside>

<style>
.profile-data {
  padding: 20px 0;
}

.label-white {
  font-size: 22px;
  font-weight: 700;
  color: white;
}

.label-gray {
  margin-top: 6px;
  font-size: 14px;
  color: #a0a0a0;
}
</style>