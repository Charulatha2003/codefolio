---
const experiences = [
    {
        role: "Java Programming Intern",
        company: "CodSoft",
        duration: "Jul 2024 – Aug 2024",
        points: [
            "Engineered three Java-based console applications — Number Game, Student Grade Calculator, and ATM Interface Simulator using OOP concepts including encapsulation, inheritance, polymorphism, and modular method structuring.",
            "Implemented input validation, exception handling, and conditional logic to build reliable and maintainable applications.",
            "Applied Java control flow, data types, and single-responsibility design principles to develop clean source code."
        ]
    },
    {
        role: "Web Development Intern",
        company: "Code Bind Technologies",
        duration: "Jun 2023 – Jul 2023",
        points: [
            "Developed a full-stack food delivery web application using HTML5 and CSS3 with structured layouts, menu sections, item cards, and order forms.",
            "Implemented responsive design using CSS media queries and fluid layouts for desktop, tablet, and mobile devices.",
            "Performed frontend debugging using browser developer tools and improved cross-browser compatibility."
        ]
    }
];
---

<section id="experience" class="experience">
<div class="container">
    <h2>Internship Experience</h2>

    <div class="container">
        {experiences.map((exp) => (
            <div class="experience-card">

                <div class="header">
                    <h3>{exp.role}</h3>
                    <span>{exp.duration}</span>
                </div>

                <h4>{exp.company}</h4>

                <ul>
                    {exp.points.map((point) => (
                        <li>{point}</li>
                    ))}
                </ul>

            </div>
        ))}
    </div>
    </div>
</section>


<style>
.experience {
    padding: 70px 0;
}


/* Section Title */
.experience h2 {
    color: #ffffff;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 42px;
    margin-bottom: 32px;
}


/* Experience Container */
.experience-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
}


/* Experience Card */
.experience-card {
    background: #1c1c1c;
    border: 1px solid #353535;
    border-radius: 12px;
    padding: 28px;
    transition: 0.3s ease;
}


.experience-card:hover {
    transform: translateY(-5px);
    border-color: #ffffff;
}


/* Job Role */
.experience-card h3 {
    color: #ffffff;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 22px;
    font-weight: 500;
    line-height: 32px;
    margin-bottom: 10px;
}


/* Company Name */
.experience-card h4 {
    color: #ffffff;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 26px;
    margin-bottom: 8px;
}


/* Duration */
.experience-card span {
    color: #a8a8a8;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 14px;
}


/* Description List */
.experience-card ul {
    margin-top: 18px;
    padding-left: 0;
    list-style: none;
}


.experience-card li {
    color: #a8a8a8;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 16px;
    line-height: 26px;
    margin-bottom: 10px;
    display: flex;
}


/* Bullet */
.experience-card li::before {
    content: "▹";
    color: #ffffff;
    margin-right: 10px;
}


/* Mobile */
@media (max-width: 600px) {

    .experience {
        padding: 50px 0;
    }

    .experience-card {
        padding: 22px;
    }

}
</style>